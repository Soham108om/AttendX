# ==============================================================================
# AttendX - Git Ignore Configuration
# ==============================================================================

# Environment variable files and secrets (NEVER commit secrets!)
.env
.env.*
!.env.example
*.env
*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Vite / Build outputs
dist/
dist-ssr/
*.local
.out/

# Testing & Coverage
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# Editor / IDE artifacts
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating System specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# AI Models & Biometric weights (Large binaries & sensitive assets)
backend/app/ai/weights/*.onnx
backend/app/ai/weights/*.pb
backend/app/ai/weights/*.pt
backend/app/ai/weights/*.pth
backend/app/ai/weights/*.bin
*.onnx
*.weights
!backend/app/ai/weights/.gitkeep
!backend/models/face_detection/*.onnx
!backend/models/face_recognition/*.onnx

# Temporary biometric image uploads & logs
temp_biometrics/
*.log
logs/
