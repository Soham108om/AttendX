# ==============================================================================
# AttendX Backend Environment Configuration (Template)
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Application Configuration
APP_ENV=development
APP_NAME=AttendX
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Configuration
# The Service Role Key MUST remain strictly on the backend and NEVER exposed to clients.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signed attendance requires a generated 32-byte-or-longer secret shared with
# Supabase Vault under the name attendx_attendance_attestation_hmac_v1.
# Keep this blank in the template; never commit the generated secret.
ATTENDANCE_ATTESTATION_SECRET=
